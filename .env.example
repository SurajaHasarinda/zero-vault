# PostgreSQL connection string
DATABASE_URL=your-database-url

# JWT Configuration
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# CORS — comma-separated origins. Leave EMPTY when the SPA is served
# same-origin (production default); the middleware is only added if this is set.
CORS_ORIGINS=

# Session cookie transport. The JWT is delivered in an httpOnly cookie, so it
# must be marked Secure whenever the app is served over HTTPS. Both compose
# files below serve plain HTTP on :8766, which is why this defaults to false —
# set it to true in any TLS-terminated deployment or the cookie will never be
# accepted by the browser.
COOKIE_SECURE=false
